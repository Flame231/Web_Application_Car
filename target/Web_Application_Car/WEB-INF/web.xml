<!DOCTYPE web-app PUBLIC
        "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
        "http://java.sun.com/dtd/web-app_2_3.dtd" >


<web-app>

    <display-name>Archetype Created Web Application</display-name>
    <servlet>
        <servlet-name>registerCar</servlet-name>
        <servlet-class>org.example.controller.registerCar</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>showAllCars</servlet-name>
        <servlet-class>org.example.controller.showAllCars</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>findCar</servlet-name>
        <servlet-class>org.example.controller.findCar</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>removeCar</servlet-name>
        <servlet-class>org.example.controller.removeCar</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>updateCar</servlet-name>
        <servlet-class>org.example.controller.updateCar</servlet-class>
    </servlet>


    <servlet-mapping>
        <servlet-name>registerCar</servlet-name>
        <url-pattern>/registerCar</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>showAllCars</servlet-name>
        <url-pattern>/showAllCars</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>findCar</servlet-name>
        <url-pattern>/findCar</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>removeCar</servlet-name>
        <url-pattern>/removeCar</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>updateCar</servlet-name>
        <url-pattern>/updateCar</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
